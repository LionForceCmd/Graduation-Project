# Скопируйте в .env (cp .env.example .env) и при необходимости поправьте. Секретов здесь нет.

# mock   — без языковой модели: ответ собирается из найденных цитат (офлайн, мгновенно)
# ollama — ответ формирует локальная модель через Ollama
LLM_PROVIDER=mock

# Нужно только для LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180

# Где лежит база SQLite (по умолчанию data/kb.sqlite3 рядом с проектом)
# DB_PATH=data/kb.sqlite3

# Поиск: доля «веса» слов вопроса, которая должна найтись во фрагменте (0..1), и число фрагментов в ответе
MIN_COVERAGE=0.45
SEARCH_TOP_K=3
